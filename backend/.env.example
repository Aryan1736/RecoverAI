# =============================================================================
# RecoverAI - Backend Environment Configuration Template
# Copy this file to .env in this directory (or project root) and configure values.
# NEVER commit real credentials or secrets to version control.
# =============================================================================

# Server Configuration
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/recoverai
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# AI Configuration (Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# Payment Gateway Configuration (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
