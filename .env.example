# =============================================================================
# RecoverAI - Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit real credentials or secrets to version control.
# =============================================================================

# Server Configuration
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/recoverai
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# AI Configuration (Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# Payment Gateway Configuration (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Recovery Communication & Execution Configuration
RECOVERY_BASE_URL=https://pay.recoverai.io/r/
WHATSAPP_PROVIDER=mock
WHATSAPP_SENDER_NUMBER=+14155238886
WHATSAPP_API_KEY=your_whatsapp_api_key_here
EMAIL_PROVIDER=mock
EMAIL_FROM_ADDRESS=recover@recoverai.io
EMAIL_FROM_NAME=RecoverAI Payment Recovery
EMAIL_API_KEY=your_email_api_key_here
SMS_PROVIDER=mock
SMS_SENDER_ID=RECOVER
SMS_API_KEY=your_sms_api_key_here
RETRY_CHARGE_PROVIDER=mock
RETRY_CHARGE_ENABLED=true
RECOVERY_OUTCOME_WEBHOOK_SIGNATURE_HEADER=X-Recovery-Signature

